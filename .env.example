CORS_ORIGIN=
GEMINI_API_KEY=
# AI engine (model independence): only 'gemini' is implemented; AI_MODEL overrides the model id.
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GH_ADMIN_KEY=
GH_RUNTIME_DIR=
MEDAUTH_REGISTRY_SECRET=
MEDAUTH_REGISTRY_URL=
NEWS_ADMIN_BOOTSTRAP_EMAIL=
NEWS_ADMIN_BOOTSTRAP_NAME=
NEWS_ADMIN_BOOTSTRAP_PASSWORD=
PRESCRIPTION_SIGNING_SECRET=
VITE_DOCTOR_PORTAL_URL=
VITE_HOSPITAL_PORTAL_URL=
VITE_PHARMACY_PORTAL_URL=
# ---- One-time secret delivery (verification codes, password-reset links) ----
# Without ONE of these, new accounts cannot be verified and password recovery
# cannot complete. /api/health/notifications reports the active transport.
# Production transport: point this at your email/SMS provider.
# NOTIFICATION_TRANSPORT=webhook
# NOTIFICATION_WEBHOOK_URL=https://your-provider.example/send
# NOTIFICATION_WEBHOOK_TIMEOUT_MS=8000
# Development/demo only: capture codes in-memory and return them to the
# requesting browser. NEVER enable this on a deployment holding real data.
# AUTH_CODE_CAPTURE=true
# Public base URL used to build password-reset links.
# APP_URL=https://globalhealth.health

# =============================================================================
# GlobalHealth — production environment template
#
# Copy to `.env` (or paste into your host's secret manager) and fill in.
#   cp .env.production.example .env
#
# Nothing here is optional in the sense of "the server refuses to boot" —
# GlobalHealth is designed to start with an empty environment and fail CLOSED
# per feature. The sections below are ordered by how much you lose without
# them. Run `npm run deploy:check` to see exactly what is missing.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Runtime (most platforms inject PORT for you — do not hardcode it)
# -----------------------------------------------------------------------------
# NODE_ENV is deliberately NOT set here.
#
# `npm start` (scripts/start.mjs) and `npm run dev` (scripts/dev.mjs) each pin
# the mode they are named for. Setting NODE_ENV in a .env file overrides that
# for BOTH commands, so copying this file to .env would make `npm run dev` boot
# in production mode — serving a stale dist/ bundle with no hot reload.
# Set NODE_ENV only if your host injects it (Render/Fly/Heroku all do).
#
# NODE_ENV=production
# PORT=3000
# GH_RUNTIME_DIR=/app/data
# APP_URL=https://your-domain.example

# -----------------------------------------------------------------------------
# 2. CORS
#
# Leave EMPTY when the SPA and API share an origin (the normal deployment,
# including the bundled Docker image). Set it only for a split deployment —
# comma-separated full origins. "*" is rejected in production.
# -----------------------------------------------------------------------------
# CORS_ORIGIN=https://your-domain.example

# -----------------------------------------------------------------------------
# 3. Security secrets — GENERATE FRESH, NEVER REUSE THE EXAMPLES
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Without PRESCRIPTION_SIGNING_SECRET prescriptions are HELD/UNSIGNED.
# Without GH_ADMIN_KEY pharmacy-partner admin verification is disabled.
# -----------------------------------------------------------------------------
# PRESCRIPTION_SIGNING_SECRET=
# GH_ADMIN_KEY=

# -----------------------------------------------------------------------------
# 4. MedAuth credential registry — verification fails closed (NOT_VERIFIED)
#    when these are absent, so set them before onboarding real clinicians.
# -----------------------------------------------------------------------------
# MEDAUTH_REGISTRY_URL=
# MEDAUTH_REGISTRY_SECRET=

# -----------------------------------------------------------------------------
# 5. AI assistant (optional — without a key it returns "not configured")
# -----------------------------------------------------------------------------
# GEMINI_API_KEY=
# AI_PROVIDER=gemini
# AI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# 6. News CMS bootstrap administrator (used once, on first boot only)
# -----------------------------------------------------------------------------
# NEWS_ADMIN_BOOTSTRAP_EMAIL=
# NEWS_ADMIN_BOOTSTRAP_NAME=
# NEWS_ADMIN_BOOTSTRAP_PASSWORD=

# -----------------------------------------------------------------------------
# 7. Optional: point the SPA at externally hosted portal workspaces
#    (Vite inlines VITE_* at BUILD time, not runtime.)
# -----------------------------------------------------------------------------
# VITE_DOCTOR_PORTAL_URL=
# VITE_HOSPITAL_PORTAL_URL=
# VITE_PHARMACY_PORTAL_URL=

# Dependencies
node_modules/

# Build output
build/
dist/
server.js

# Test + coverage artifacts
coverage/
.nyc_output/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp

# Logs
*.log
npm-debug.log*

# ---------------------------------------------------------------------------
# Secrets. Every real .env variant is ignored; the committed templates are
# re-included explicitly below. Bare `.env*` would also swallow
# `.env.production.example`, so the negations have to follow it.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.production.example

# Local tooling caches
.cache/
.turbo/
.tmp/

# ---------------------------------------------------------------------------
# Runtime disk-backed persistence (never commit user data)
# ---------------------------------------------------------------------------
data/
!data/.gitkeep
